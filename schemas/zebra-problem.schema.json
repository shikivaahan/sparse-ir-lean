{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikivaahan/sparse-ir-lean/schemas/zebra-problem.schema.json",
  "title": "SparseIR Zebra problem",
  "type": "object",
  "required": ["schema_version", "domain", "id", "source", "size", "categories", "clues"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "size": {"$ref": "#/$defs/size"},
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "clues": {"type": "array", "items": {"$ref": "#/$defs/clue"}},
    "expect": {}
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["dataset", "split", "external_id", "grid"],
      "properties": {
        "dataset": {"const": "zebralogic"},
        "split": {"type": "string", "minLength": 1},
        "external_id": {"type": "string", "minLength": 1},
        "grid": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"}
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": ["houses", "categories"],
      "properties": {
        "houses": {"type": "integer", "minimum": 1},
        "categories": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "required": ["cat", "val"],
      "properties": {
        "cat": {"type": "string", "minLength": 1},
        "val": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "at_clue": {
      "type": "object",
      "required": ["id", "type", "cat", "val", "house"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["found_at", "not_at"]},
        "cat": {"type": "string", "minLength": 1},
        "val": {"type": "string", "minLength": 1},
        "house": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "relational_clue": {
      "type": "object",
      "required": ["id", "type", "a", "b"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["same_house", "direct_left", "direct_right", "side_by_side", "left_of", "right_of", "one_between", "two_between"]
        },
        "a": {"$ref": "#/$defs/attribute"},
        "b": {"$ref": "#/$defs/attribute"}
      },
      "additionalProperties": false
    },
    "clue": {"oneOf": [{"$ref": "#/$defs/at_clue"}, {"$ref": "#/$defs/relational_clue"}]}
  },
  "x-sparseir-interface": {
    "version": "0.2",
    "status": "frozen-stage-2",
    "unknown-field-policy": "reject"
  },
  "x-sparseir-parse-error-codes": [
    "invalid_json",
    "expected_object",
    "missing_field",
    "unknown_field",
    "invalid_field_type",
    "invalid_value",
    "invalid_house",
    "unknown_clue_type"
  ],
  "x-sparseir-static-error-codes": [
    "invalid_json",
    "invalid_schema",
    "unsupported_schema_version",
    "invalid_domain",
    "size_mismatch",
    "category_size_mismatch",
    "duplicate_value",
    "unknown_category",
    "unknown_value",
    "house_out_of_range",
    "duplicate_clue_id"
  ]
}
